{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "六卡技能展示生成器",
  "version": "0.1.2",
  "identifier": "top.skillcardforge.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "六卡技能展示生成器",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Graphics and Design",
    "shortDescription": "离线六卡技能展示生成器",
    "longDescription": "用结构化文本生成六张可导出的技能展示卡片。"
  }
}
